/-
Sha384sum.Logic — Verified pure SHA-384 hash implementation. 0BSD
Reuses SHA-512 core with SHA-384 initial values and truncated output (48 bytes).
Provenance: FIPS 180-4.
-/

import Lentils.Sha512sum.Logic

namespace Lentils.Sha384sum.Logic
open Lentils.Sha512sum.Logic

structure HashInput where
  data : ByteArray
  deriving Inhabited, BEq

def sha384 (data : ByteArray) : ByteArray := sha512WithInit initH384 6 data
def formatHex (hash : ByteArray) : String := Lentils.Sha512sum.Logic.formatHex hash
def formatStdin (data : ByteArray) : String := formatHex (sha384 data) ++ "  -\n"

def spec (input : HashInput) : ByteArray := sha384 input.data

theorem i_output_size (data : ByteArray) : (sha384 data).size = 48 := by
  have h := sha512WithInit_size initH384 6 data
  simpa [sha384] using h

theorem i_formatHex_empty : formatHex ByteArray.empty = "" := Lentils.Sha512sum.Logic.i_formatHex_empty
theorem i_formatStdin_compose (data : ByteArray) : formatStdin data = formatHex (sha384 data) ++ "  -\n" := rfl

example : sha384 ByteArray.empty = ByteArray.mk (List.toArray ([0x38,0xb0,0x60,0xa7,0x51,0xac,0x96,0x38,0x4c,0xd9,0x32,0x7e,0xb1,0xb1,0xe3,0x6a,0x21,0xfd,0xb7,0x11,0x14,0xbe,0x07,0x43,0x4c,0x0c,0xc7,0xbf,0x63,0xf6,0xe1,0xda,0x27,0x4e,0xde,0xbf,0xe7,0x6f,0x65,0xfb,0xd5,0x1a,0xd2,0xf1,0x48,0x98,0xb9,0x5b] : List UInt8)) := by native_decide
example : sha384 "abc".toUTF8 = ByteArray.mk (List.toArray ([0xcb,0x00,0x75,0x3f,0x45,0xa3,0x5e,0x8b,0xb5,0xa0,0x3d,0x69,0x9a,0xc6,0x50,0x07,0x27,0x2c,0x32,0xab,0x0e,0xde,0xd1,0x63,0x1a,0x8b,0x60,0x5a,0x43,0xff,0x5b,0xed,0x80,0x86,0x07,0x2b,0xa1,0xe7,0xcc,0x23,0x58,0xba,0xec,0xa1,0x34,0xc8,0x25,0xa7] : List UInt8)) := by native_decide
example : (sha384 ByteArray.empty).size = 48 := i_output_size ByteArray.empty

end Lentils.Sha384sum.Logic
